<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.dao.food-mapper">
	<select id="foodListData" resultType="FoodVO" parameterType="int">
		SELECT fno,poster,name
		FROM food
		ORDER BY fno
		OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
	</select>
	<!-- 
		인라인뷰 : rownum은 TOP-N (처음부터 ~, 중간값은 갖고올수 없음)
		SELECT fno,poster,name,num
		FROM (SELECT no,poster,name,rownum as num
			FROM(SELECT no,poster,name
				FROM food ORDER BY fno ASC))
		WHERE num BETWEEN #{start} AND #{end}
		
		MySQL(MariaDB)
		SELECT fno,poster,name
		FROM food
		ORDER BY no ASC
		LIMIT ?,12
	 -->
	<select id="foodTotalPage" resultType="int">
		SELECT CEIL(COUNT(*)/12.0)
		FROM food
	</select>
	<select id="foodDetailData" resultType="FoodVO" parameterType="int">
     SELECT *
     FROM food
     WHERE fno=#{fno}
   </select>
</mapper>