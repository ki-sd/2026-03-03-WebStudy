<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<!-- Connection + VO + SQL문장 -->
<configuration>
	<!-- 
	properties?, settings?, typeAliases?, typeHandlers?, objectFactory?, objectWrapperFactory?, 
    reflectorFactory?, plugins?, environments?, databaseIdProvider?, mappers?
    
    properties : 데이터베이스 정보 읽기 => .properties
    settings : 캐시메모리 활용 => 같은 SQL이면 => 저장된 데이터
    typeAliases : VO등록
    typeHandlers : 데이터 변경
    mappers : SQL문장 위치 확인
	 -->
	 <!-- 1. VO등록 -->
	<typeAliases>
		<typeAlias type="com.sist.vo.DataBoardVO" alias="DataBoardVO"/>
	</typeAliases>
	<!-- 2. Connection 설정 => getConnection() / disConnection() -->
	<environments default="development">
		<environment id="development">
		<!-- (transactionManager,dataSource) : default는 반드시 한번만 필수 사용
		                         | database 정보
		                         => UNPOOLED / POOLED
		                            |JDBC      |DBCP
		      | commit / rollback
		      => JDBC / MANAGE(미리 설정해서 만듬)
		 -->
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<property name="driver" value="oracle.jdbc.driver.OracleDriver"/>
				<property name="url" value="jdbc:oracle:thin:@localhost:1521:XE"/>
				<property name="username" value="hr"/>
				<property name="password" value="happy"/>
				<!-- 
				    디폴트값
					maxActive=8 / maxIdle=8 / maxWait=10000
				 -->
			</dataSource>
		</environment>
	</environments>
	<mappers>
		<mapper resource="com/sist/dao/databoard-mapper.xml"/>
	</mappers>
</configuration>